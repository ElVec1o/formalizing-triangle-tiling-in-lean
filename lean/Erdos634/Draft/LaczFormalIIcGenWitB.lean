abbrev Pt := Z2 × Z2

structure TZ where
  p0 : Pt
  p1 : Pt
  p2 : Pt
deriving DecidableEq

instance : Inhabited TZ := ⟨⟨(zero, zero), (zero, zero), (zero, zero)⟩⟩

def TZ.pt (t : TZ) : Fin 3 → Pt
  | 0 => t.p0
  | 1 => t.p1
  | 2 => t.p2

def decPt (l : List Int) (o : Nat) : Pt := (⟨l.getD o 0, l.getD (o + 1) 0⟩, ⟨l.getD (o + 2) 0, l.getD (o + 3) 0⟩)
def decTZ (l : List Int) : TZ := ⟨decPt l 0, decPt l 4, decPt l 8⟩

def tileTab : List TZ := tileData.map decTZ
def polyN (n : Nat) : Pt := decPt (polyData.getD n []) 0
def polyV (i : Fin 8) : Pt := polyN i.val

/-- twice the signed area of `p q r` in doubled coordinates (four times the real one). -/
def detZ (p q r : Pt) : Z2 := sub (mul (sub q.1 p.1) (sub r.2 p.2)) (mul (sub r.1 p.1) (sub q.2 p.2))
def d2 (p q : Pt) : Z2 := add (mul (sub p.1 q.1) (sub p.1 q.1)) (mul (sub p.2 q.2) (sub p.2 q.2))
def detT (t : TZ) : Z2 := detZ t.p0 t.p1 t.p2
def absZ (z : Z2) : Z2 := if posB z then z else neg z

/-- the model tile: alpha-vertex `(sqrt2, sqrt2)`, beta-vertex `(1, 0)`, gamma-vertex `(0,0)` (doubled). -/
def modelTZ : TZ := ⟨(⟨0, 2⟩, ⟨0, 2⟩), (⟨2, 0⟩, ⟨0, 0⟩), (⟨0, 0⟩, ⟨0, 0⟩)⟩

def validB (t : TZ) : Bool := !(decide (detT t = zero))
def congB (t : TZ) : Bool := (List.finRange 3).all fun k => (List.finRange 3).all fun l => decide (d2 (t.pt k) (t.pt l) = d2 (modelTZ.pt k) (modelTZ.pt l))
def vtxB (f : Pt → Bool) (t : TZ) : Bool := f t.p0 && f t.p1 && f t.p2
def inB (t : TZ) : Bool := (List.finRange 8).all fun e => vtxB (fun v => geB (detZ (polyV e) (polyV (e + 1)) v)) t

def edgeSep (p q : Pt) (A B : TZ) : Bool :=
  decide (p ≠ q) &&
  ((vtxB (fun v => geB (detZ p q v)) A && vtxB (fun v => leB (detZ p q v)) B) ||
   (vtxB (fun v => leB (detZ p q v)) A && vtxB (fun v => geB (detZ p q v)) B))

def sepB (A B : TZ) : Bool :=
  edgeSep A.p0 A.p1 A B || edgeSep A.p1 A.p2 A B || edgeSep A.p2 A.p0 A B ||
  edgeSep B.p0 B.p1 A B || edgeSep B.p1 B.p2 A B || edgeSep B.p2 B.p0 A B

def pairsAll : List TZ → Bool
  | [] => true
  | t :: rest => rest.all (sepB t) && pairsAll rest

def convB : Bool := (List.finRange 8).all fun i => (List.finRange 8).all fun j =>
  decide (j = i) || decide (j = i + 1) || posB (detZ (polyV i) (polyV (i + 1)) (polyV j))

/-- the fan of the octagon from `V0`. -/
def fanTab : List TZ := (List.range 6).map fun k => ⟨polyN 0, polyN (k + 1), polyN (k + 2)⟩

def posT (t : TZ) : Bool := posB (detT t)

def sumZ (l : List Z2) : Z2 := l.foldl add zero

def alphaL : List Pt := tileTab.map TZ.p0
def betaL : List Pt := tileTab.map TZ.p1
def gammaL : List Pt := tileTab.map TZ.p2

def regB : Bool := (alphaL ++ betaL).all fun p => alphaL.count p == betaL.count p
def corB : Bool := (List.finRange 8).all fun j => alphaL.count (polyV j) == 1 && betaL.count (polyV j) == 1 && gammaL.count (polyV j) == 0

end Erdos634.Draft.LaczFormal.GenWit
