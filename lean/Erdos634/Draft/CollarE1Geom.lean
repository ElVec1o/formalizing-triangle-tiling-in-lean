  | ⟨3, _⟩, ⟨0, _⟩ => (dZ_0_3 hd hτ).symm
  | ⟨3, _⟩, ⟨1, _⟩ => (dZ_1_3 hd hτ).symm
  | ⟨3, _⟩, ⟨2, _⟩ => (dZ_2_3 hd hτ).symm
  | ⟨3, _⟩, ⟨3, _⟩ => absurd rfl hab
  | ⟨3, _⟩, ⟨4, _⟩ => dZ_3_4 hd hτ
  | ⟨3, _⟩, ⟨5, _⟩ => dZ_3_5 hd hτ
