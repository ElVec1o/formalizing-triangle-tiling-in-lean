theorem xg_3 : ∀ p ∈ Z3 d τ, cA d * ct d τ ≤ p.1 := by
  intro p hp
  have h := x_ge_3 hd hτ p hp
  have e : (d ^ 4 + d ^ 3 * τ + 8 * d ^ 3 + 6 * d ^ 2 * τ + 23 * d ^ 2 + 11 * d * τ + 28 * d + 6 * τ + 12) = cA d * ct d τ := by simp only [cA, ct]; ring
  rw [e] at h; simpa only [one_mul, zero_mul, add_zero] using h
