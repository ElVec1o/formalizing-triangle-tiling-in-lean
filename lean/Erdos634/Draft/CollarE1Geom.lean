/-! ### the nine regions as a family -/
theorem Zf_sub : ∀ a : Fin 9, Zf d τ a ⊆ ZT d τ := fun a => match a with
  | ⟨0, _⟩ => Z0_sub hd hτ
  | ⟨1, _⟩ => Z1_sub hd hτ
  | ⟨2, _⟩ => Z2_sub hd hτ
  | ⟨3, _⟩ => Z3_sub hd hτ
  | ⟨4, _⟩ => Z4_sub hd hτ
  | ⟨5, _⟩ => Z5_sub hd hτ
  | ⟨6, _⟩ => Z6_sub hd hτ
  | ⟨7, _⟩ => Z7_sub hd hτ
  | ⟨8, _⟩ => Z8_sub hd hτ
  | ⟨k + 9, h⟩ => absurd h (by omega)

theorem dZ_all : ∀ a b : Fin 9, a ≠ b → Disjoint (interior (Zf d τ a)) (interior (Zf d τ b)) := by
  intro a b hab
  exact match a, b with
  | ⟨0, _⟩, ⟨0, _⟩ => absurd rfl hab
  | ⟨0, _⟩, ⟨1, _⟩ => dZ_0_1 hd hτ
  | ⟨0, _⟩, ⟨2, _⟩ => dZ_0_2 hd hτ
  | ⟨0, _⟩, ⟨3, _⟩ => dZ_0_3 hd hτ
  | ⟨0, _⟩, ⟨4, _⟩ => dZ_0_4 hd hτ
  | ⟨0, _⟩, ⟨5, _⟩ => dZ_0_5 hd hτ
  | ⟨0, _⟩, ⟨6, _⟩ => dZ_0_6 hd hτ
  | ⟨0, _⟩, ⟨7, _⟩ => dZ_0_7 hd hτ
  | ⟨0, _⟩, ⟨8, _⟩ => dZ_0_8 hd hτ
  | ⟨1, _⟩, ⟨0, _⟩ => (dZ_0_1 hd hτ).symm
  | ⟨1, _⟩, ⟨1, _⟩ => absurd rfl hab
  | ⟨1, _⟩, ⟨2, _⟩ => dZ_1_2 hd hτ
  | ⟨1, _⟩, ⟨3, _⟩ => dZ_1_3 hd hτ
  | ⟨1, _⟩, ⟨4, _⟩ => dZ_1_4 hd hτ
  | ⟨1, _⟩, ⟨5, _⟩ => dZ_1_5 hd hτ
  | ⟨1, _⟩, ⟨6, _⟩ => dZ_1_6 hd hτ
  | ⟨1, _⟩, ⟨7, _⟩ => dZ_1_7 hd hτ
  | ⟨1, _⟩, ⟨8, _⟩ => dZ_1_8 hd hτ
  | ⟨2, _⟩, ⟨0, _⟩ => (dZ_0_2 hd hτ).symm
  | ⟨2, _⟩, ⟨1, _⟩ => (dZ_1_2 hd hτ).symm
  | ⟨2, _⟩, ⟨2, _⟩ => absurd rfl hab
  | ⟨2, _⟩, ⟨3, _⟩ => dZ_2_3 hd hτ
  | ⟨2, _⟩, ⟨4, _⟩ => dZ_2_4 hd hτ
