/-- a parallelogram, as the convex hull of its four corners -/
def Pg (P0 E1 E2 : ℝ × ℝ) : Set (ℝ × ℝ) := convexHull ℝ {P0, P0 + E1, P0 + E1 + E2, P0 + E2}

