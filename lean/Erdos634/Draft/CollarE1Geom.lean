    cA d * (ct d τ + 1) * (cB d * (ct d τ + 1)) ≤ cB d * (ct d τ + 1) * p.1 + cA d * (ct d τ + 1) * p.2
  refine ⟨h1, h2, ?_⟩
  have ht := ct_pos hd hτ
  nlinarith [mul_le_mul_of_nonneg_left h3 (by linarith : (0 : ℝ) ≤ ct d τ + 1)]

