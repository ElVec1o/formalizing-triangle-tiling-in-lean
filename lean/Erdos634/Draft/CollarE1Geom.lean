/-! ### the regions `Z0`, `Z1`, `Z2` -/
theorem Z0_mem (p : ℝ × ℝ) (hp : p ∈ Z0 d τ) :
    p.1 ≤ cA d * ct d τ ∧ p.2 - cB d ≤ cB d * ct d τ ∧ cA d * cB d * ct d τ ≤ cB d * p.1 + cA d * (p.2 - cB d) := by
  have hp' : (p - (0, cB d)).1 ≤ cA d * ct d τ ∧ (p - (0, cB d)).2 ≤ cB d * ct d τ ∧
      cA d * cB d * ct d τ ≤ cB d * (p - (0, cB d)).1 + cA d * (p - (0, cB d)).2 := hp
  simpa only [Prod.fst_sub, Prod.snd_sub, sub_zero] using hp'

theorem yL_le : cB d + cL d + (d + 2) ^ 2 * ct d τ < cB d * (ct d τ + 1) := by
  have e : cB d * (ct d τ + 1) - (cB d + cL d + (d + 2) ^ 2 * ct d τ) = d ^ 2 * τ + d ^ 2 + 4 * d * τ + 4 * d + 3 * τ + 3 := by
    simp only [cB, cL, ct]; ring
  have : (0 : ℝ) < d ^ 2 * τ + d ^ 2 + 4 * d * τ + 4 * d + 3 * τ + 3 := by positivity
  linarith

theorem Z0_sub : Z0 d τ ⊆ ZT d τ := by
  intro p hp
  obtain ⟨h1, h2, h3⟩ := Z0_mem hd hτ p hp
  have hA := cA_pos hd hτ
  have hB := cB_pos hd hτ
  refine mem_ZT hd hτ p ?_ ?_ ?_
  · nlinarith
  · linarith
  · nlinarith

