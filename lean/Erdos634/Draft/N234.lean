import Erdos634.R234TilingBridge
import Erdos634.Realizable
import Erdos634.Draft.TileCountFamilies
import Erdos634.Draft.HasSidesPerm

namespace Erdos634.Draft.N234

open Erdos634.Geometry Erdos634.Draft.TileCountFamilies Erdos634.Draft.FDBBaseBetaE1

/-- **234 is a tile count.** -/
theorem tileCount_234 : TileCount 234 := Erdos634.R234TilingBridge.r234_nonempty_congruentDissection

/-- `234 k²` is a tile count for every `k ≥ 1`. -/
theorem tileCount_234_sq {k : ℕ} (hk : 0 < k) : TileCount (k * k * 234) := tileCount_scale tileCount_234 hk

theorem eq_of_sq {d c : ℝ} (hd : 0 ≤ d) (hc : 0 < c) (h : d ^ 2 = c ^ 2) : d = c := by
  have h2 : (d - c) * (d + c) = 0 := by linear_combination h
  rcases mul_eq_zero.mp h2 with h3 | h3
  · linarith
  · linarith

/-- **The 234-tiling with its side lengths**: the target has sides `13122, 13122, 12636` and the tile
`486, 1296, 1458`. -/
theorem dissection_234_sides :
    ∃ D : CongruentDissection 234,
      dist (D.target.pts 0) (D.target.pts 1) = 13122 ∧ dist (D.target.pts 1) (D.target.pts 2) = 13122 ∧
      dist (D.target.pts 2) (D.target.pts 0) = 12636 ∧
      dist (D.model.pts 0) (D.model.pts 1) = 486 ∧ dist (D.model.pts 1) (D.model.pts 2) = 1296 ∧
      dist (D.model.pts 2) (D.model.pts 0) = 1458 := by
  obtain ⟨D, t1, t2, t3, m1, m2, m3⟩ := Erdos634.R234TilingBridge.r234_dissection_shape
  exact ⟨D, eq_of_sq dist_nonneg (by norm_num) (by rw [t1]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [t2]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [t3]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [m1]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [m2]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [m3]; norm_num)⟩

open Erdos634.Realizable in
/-- **The base-β target of the member `(1, 3)` at scale `3` has a tiling**: a triangle with sides `81, 81, 78` is cut
into `234` congruent triangles with sides `3, 8, 9`. -/
theorem basebeta_1_3_scale_three :
    ∃ D : CongruentDissection 234, HasSides D.target 81 81 78 ∧ HasSides D.model 3 8 9 := by
  obtain ⟨D, t01, t12, t20, m01, m12, m20⟩ := dissection_234_sides
  have hν : (0:ℝ) < 1 / 162 := by norm_num
  set Ds := scaleDissection (D.model.pts 0) (1 / 162) hν.ne' D with hDs
  have htd : ∀ i j : Fin 3,
      dist (Ds.target.pts i) (Ds.target.pts j) = 1 / 162 * dist (D.target.pts i) (D.target.pts j) := by
    intro i j
    rw [hDs, scaleDissection_target_pts, scaleDissection_target_pts, homothetyEquiv_dist, abs_of_pos hν]
  have hmd : ∀ i j : Fin 3,
      dist (Ds.model.pts i) (Ds.model.pts j) = 1 / 162 * dist (D.model.pts i) (D.model.pts j) := by
    intro i j
    rw [hDs, scaleDissection_model_pts, scaleDissection_model_pts, homothetyEquiv_dist, abs_of_pos hν]
  have e01 := htd 0 1
  have e12 := htd 1 2
  have e20 := htd 2 0
  have f01 := hmd 0 1
  have f12 := hmd 1 2
  have f20 := hmd 2 0
  rw [t01] at e01
  rw [t12] at e12
  rw [t20] at e20
  rw [m01] at f01
  rw [m12] at f12
  rw [m20] at f20
  -- `HasSides T a b c` with the identity labelling reads `dist 1 2 = a`, `dist 2 0 = b`, `dist 0 1 = c`
  have hT : HasSides Ds.target 81 78 81 :=
    ⟨Equiv.refl _, by simp only [Equiv.refl_apply]; rw [e12]; norm_num,
      by simp only [Equiv.refl_apply]; rw [e20]; norm_num, by simp only [Equiv.refl_apply]; rw [e01]; norm_num⟩
  have hM : HasSides Ds.model 8 9 3 :=
    ⟨Equiv.refl _, by simp only [Equiv.refl_apply]; rw [f12]; norm_num,
      by simp only [Equiv.refl_apply]; rw [f20]; norm_num, by simp only [Equiv.refl_apply]; rw [f01]; norm_num⟩
  exact ⟨Ds, hasSides_rot (hasSides_rot hT), hasSides_rot (hasSides_rot hM)⟩

end Erdos634.Draft.N234

#print axioms Erdos634.Draft.N234.tileCount_234
