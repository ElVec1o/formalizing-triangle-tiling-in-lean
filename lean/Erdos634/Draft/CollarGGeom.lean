theorem Zf_sub : ∀ a : Fin 9, Zf u e σ a ⊆ ZT u e σ := fun a => match a with
  | ⟨0, _⟩ => Z0_sub hu he hσ
  | ⟨1, _⟩ => Z1_sub hu he hσ
  | ⟨2, _⟩ => Z2_sub hu he hσ
  | ⟨3, _⟩ => Z3_sub hu he hσ
  | ⟨4, _⟩ => Z4_sub hu he hσ
