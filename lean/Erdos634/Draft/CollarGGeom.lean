  · linarith

/-! ### the regions `Z0`, `Z1`, `Z2` -/
theorem Z0_mem (q : ℝ × ℝ) (hq : q ∈ Z0 u e σ) :
    q.1 ≤ cA u e * ct e σ ∧ q.2 - cB u e * u ≤ cB u e * ct e σ ∧
      cA u e * cB u e * ct e σ ≤ cB u e * q.1 + cA u e * (q.2 - cB u e * u) := by
  have hq' : (q - (0, cB u e * u)).1 ≤ cA u e * ct e σ ∧ (q - (0, cB u e * u)).2 ≤ cB u e * ct e σ ∧
      cA u e * cB u e * ct e σ ≤ cB u e * (q - (0, cB u e * u)).1 + cA u e * (q - (0, cB u e * u)).2 := hq
  simpa only [Prod.fst_sub, Prod.snd_sub, sub_zero] using hq'

theorem yL_le : cB u e * u + cL u e + ca u e * (u + e) * ct e σ < cB u e * (ct e σ + u) := by
  have hE : cB u e * (ct e σ + u) - (cB u e * u + cL u e + ca u e * (u + e) * ct e σ) = 2 * u ^ 2 * e * σ + u * e ^ 2 * σ := by
    simp only [ca, cB, cL, ct]; ring
  have : (0 : ℝ) < 2 * u ^ 2 * e * σ + u * e ^ 2 * σ := by positivity
  linarith

theorem hrow : (0 : ℝ) ≤ ca u e * (u + e) * ct e σ := by
  have h1 := ca_pos hu he hσ
  have h2 := ct_pos hu he hσ
  positivity

theorem Z0_sub : Z0 u e σ ⊆ ZT u e σ := by
  intro q hq
  obtain ⟨h1, h2, h3⟩ := Z0_mem hu he hσ q hq
  have hA := cA_pos hu he hσ
  have hB := cB_pos hu he hσ
  refine mem_ZT hu he hσ q ?_ ?_ ?_
  · nlinarith [mul_pos hA hu]
  · nlinarith
  · nlinarith

theorem Z1_sub : Z1 u e σ ⊆ ZT u e σ := by
  intro q hq
  obtain ⟨h1, h2, h3, h4⟩ := hq
  have hA := cA_pos hu he hσ
  have hB := cB_pos hu he hσ
  have hL := cL_pos hu he hσ
  have hy := yL_le hu he hσ
  refine mem_ZT hu he hσ q ?_ ?_ ?_
  · nlinarith
  · linarith
  · nlinarith [mul_le_mul_of_nonneg_left h1 hB.le, mul_le_mul_of_nonneg_left h3 hA.le, mul_pos hA hL]

