/-- `a = u v` -/
def ca (u e : ℝ) : ℝ := u * (u + e)
/-- `b = v² − u²` -/
def cb (u e : ℝ) : ℝ := (u + e) ^ 2 - u ^ 2
/-- `Q = 2v² − u²` -/
def cQ (u e : ℝ) : ℝ := 2 * (u + e) ^ 2 - u ^ 2
/-- `A = v b` -/
def cA (u e : ℝ) : ℝ := (u + e) * ((u + e) ^ 2 - u ^ 2)
/-- `B = u Q` -/
def cB (u e : ℝ) : ℝ := u * (2 * (u + e) ^ 2 - u ^ 2)
/-- `L₀ = u (v − u) b` -/
def cL (u e : ℝ) : ℝ := u * e * ((u + e) ^ 2 - u ^ 2)
/-- the scale `t = e + σ` -/
def ct (e σ : ℝ) : ℝ := e + σ

noncomputable def qO (u e σ : ℝ) : ℝ × ℝ := ((2 * u ^ 3 * e + 5 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 4 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), (u ^ 4 + 4 * u ^ 3 * e + 4 * u ^ 2 * e ^ 2 + u * e ^ 3))
noncomputable def qK (u e σ : ℝ) : ℝ × ℝ := ((2 * u ^ 3 * e + 5 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 4 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), (u ^ 3 * e + u ^ 2 * e ^ 2))
noncomputable def qR (u e σ : ℝ) : ℝ × ℝ := ((4 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 4 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), ((u ^ 5 + 5 * u ^ 4 * e + 4 * u ^ 3 * e ^ 2 + u ^ 2 * e ^ 3) / (u + e)))
noncomputable def qX (u e σ : ℝ) : ℝ × ℝ := ((u ^ 3 * e + 5 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 4 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), ((u ^ 5 + 5 * u ^ 4 * e + 6 * u ^ 3 * e ^ 2 + 4 * u ^ 2 * e ^ 3 + u * e ^ 4) / (u + e)))
noncomputable def qJ (u e σ : ℝ) : ℝ × ℝ := ((u ^ 3 * e + 3 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 3 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), (u ^ 4 + 4 * u ^ 3 * e + 4 * u ^ 2 * e ^ 2 + u * e ^ 3))
noncomputable def qC (u e σ : ℝ) : ℝ × ℝ := ((2 * u ^ 3 * e + 5 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 4 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), (0))
noncomputable def qE (u e σ : ℝ) : ℝ × ℝ := ((2 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 3 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), (u ^ 4 + 4 * u ^ 3 * e + 2 * u ^ 2 * e ^ 2))
noncomputable def qBp (u e σ : ℝ) : ℝ × ℝ := ((2 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 3 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), (u ^ 4 + 4 * u ^ 3 * e + 4 * u ^ 2 * e ^ 2 + u * e ^ 3))
noncomputable def qY (u e σ : ℝ) : ℝ × ℝ := ((4 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 4 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ), ((u ^ 5 + 4 * u ^ 4 * e + 2 * u ^ 3 * e ^ 2) / (u + e)))
noncomputable def vr (u e : ℝ) : ℝ × ℝ := ((-u ^ 2), ((-2 * u ^ 2 * e - u * e ^ 2) / (u + e)))
noncomputable def vs (u e : ℝ) : ℝ × ℝ := ((-2 * u * e - e ^ 2), ((2 * u ^ 2 * e + u * e ^ 2) / (u + e)))
noncomputable def vp (u e : ℝ) : ℝ × ℝ := ((0), (-u ^ 2 - u * e))
noncomputable def vw (u e : ℝ) : ℝ × ℝ := ((-2 * u * e - e ^ 2), ((u ^ 3 + 4 * u ^ 2 * e + 2 * u * e ^ 2) / (u + e)))

/-- a parallelogram, as the convex hull of its four corners -/
def Pg (P0 E1 E2 : ℝ × ℝ) : Set (ℝ × ℝ) := convexHull ℝ {P0, P0 + E1, P0 + E1 + E2, P0 + E2}

def Z0 (u e σ : ℝ) : Set (ℝ × ℝ) := Sh (0, cB u e * u) (Wt (cA u e) (cB u e) (ct e σ))
def Z1 (u e σ : ℝ) : Set (ℝ × ℝ) :=
  Rect (cA u e * ct e σ) (cA u e * ct e σ + cA u e * u) (cB u e * u + cL u e)
    (cB u e * u + cL u e + ca u e * (u + e) * ct e σ)
def Z2 (u e σ : ℝ) : Set (ℝ × ℝ) :=
  Rect (cA u e * ct e σ) (cA u e * ct e σ + cA u e * u)
    (cB u e * u + cL u e + ca u e * (u + e) * ct e σ) (cB u e * (ct e σ + u))
noncomputable def Z3 (u e σ : ℝ) : Set (ℝ × ℝ) := convexHull ℝ {qK u e σ, qR u e σ, qO u e σ}
noncomputable def Z4 (u e σ : ℝ) : Set (ℝ × ℝ) := convexHull ℝ {qJ u e σ, qBp u e σ, qE u e σ}
noncomputable def Z5 (u e σ : ℝ) : Set (ℝ × ℝ) := convexHull ℝ {qO u e σ, qX u e σ, qJ u e σ}
noncomputable def Z6 (u e σ : ℝ) : Set (ℝ × ℝ) :=
  Pg (qX u e σ) ((e * (u + e)) • vr u e) ((u * e) • vs u e)
noncomputable def Z7 (u e σ : ℝ) : Set (ℝ × ℝ) :=
  Pg (qK u e σ) ((u * e) • vp u e) ((u ^ 2) • vw u e)
noncomputable def Z8 (u e σ : ℝ) : Set (ℝ × ℝ) := convexHull ℝ {qY u e σ, qR u e σ, qE u e σ}
/-- the target `W_{t+u}` -/
def ZT (u e σ : ℝ) : Set (ℝ × ℝ) := WS (cA u e * (ct e σ + u)) (cB u e * (ct e σ + u))
/-- the nine regions, indexed -/
noncomputable def Zf (u e σ : ℝ) : Fin 9 → Set (ℝ × ℝ) := fun i => match i with
  | ⟨0, _⟩ => Z0 u e σ
  | ⟨1, _⟩ => Z1 u e σ
  | ⟨2, _⟩ => Z2 u e σ
  | ⟨3, _⟩ => Z3 u e σ
  | ⟨4, _⟩ => Z4 u e σ
  | ⟨5, _⟩ => Z5 u e σ
  | ⟨6, _⟩ => Z6 u e σ
  | ⟨7, _⟩ => Z7 u e σ
  | ⟨8, _⟩ => Z8 u e σ
  | ⟨k + 9, h⟩ => absurd h (by omega)

section real
variable {u e σ : ℝ} (hu : 0 < u) (he : 0 < e) (hσ : 0 < σ)
