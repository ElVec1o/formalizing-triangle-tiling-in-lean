theorem cA_pos : 0 < cA u e := by
  have hE : cA u e = 2 * u ^ 2 * e + 3 * u * e ^ 2 + e ^ 3 := by simp only [cA]; ring
  rw [hE]; positivity
theorem cB_pos : 0 < cB u e := by
  have hE : cB u e = u ^ 3 + 4 * u ^ 2 * e + 2 * u * e ^ 2 := by simp only [cB]; ring
  rw [hE]; positivity
theorem cL_pos : 0 < cL u e := by
  have hE : cL u e = 2 * u ^ 2 * e ^ 2 + u * e ^ 3 := by simp only [cL]; ring
  rw [hE]; positivity
theorem ca_pos : 0 < ca u e := by
  have hE : ca u e = u ^ 2 + u * e := by simp only [ca]; ring
  rw [hE]; positivity
theorem cb_pos : 0 < cb u e := by
  have hE : cb u e = 2 * u * e + e ^ 2 := by simp only [cb]; ring
  rw [hE]; positivity
theorem ct_pos : 0 < ct e σ := by simp only [ct]; positivity

theorem mem_ZT (q : ℝ × ℝ) (h1 : q.1 ≤ cA u e * (ct e σ + u)) (h2 : q.2 ≤ cB u e * (ct e σ + u))
    (h3 : cA u e * cB u e * (ct e σ + u) ≤ cB u e * q.1 + cA u e * q.2) : q ∈ ZT u e σ := by
  show q.1 ≤ cA u e * (ct e σ + u) ∧ q.2 ≤ cB u e * (ct e σ + u) ∧
    cA u e * (ct e σ + u) * (cB u e * (ct e σ + u))
      ≤ cB u e * (ct e σ + u) * q.1 + cA u e * (ct e σ + u) * q.2
  refine ⟨h1, h2, ?_⟩
  have ht := ct_pos hu he hσ
  nlinarith [mul_le_mul_of_nonneg_left h3 (by linarith : (0 : ℝ) ≤ ct e σ + u)]

