theorem Z3_sub : Z3 u e σ ⊆ ZT u e σ := by
  intro q hq
  have h1 := x_le_3 hu he hσ q hq
  have h2 := y_le_3 hu he hσ q hq
  have h3 := w_ge_3 hu he hσ q hq
  have hy := yL_le hu he hσ
  have hF := hrow hu he hσ
  have eA : (2 * u ^ 3 * e + 5 * u ^ 2 * e ^ 2 + 2 * u ^ 2 * e * σ + 4 * u * e ^ 3 + 3 * u * e ^ 2 * σ + e ^ 4 + e ^ 3 * σ) = cA u e * (ct e σ + u) := by simp only [cA, ct]; ring
  have eL : (u ^ 4 + 4 * u ^ 3 * e + 4 * u ^ 2 * e ^ 2 + u * e ^ 3) = cB u e * u + cL u e := by simp only [cB, cL]; ring
  have eW : (2 * u ^ 6 * e + 13 * u ^ 5 * e ^ 2 + 2 * u ^ 5 * e * σ + 28 * u ^ 4 * e ^ 3 + 11 * u ^ 4 * e ^ 2 * σ + 27 * u ^ 3 * e ^ 4 + 17 * u ^ 3 * e ^ 3 * σ + 12 * u ^ 2 * e ^ 5 + 10 * u ^ 2 * e ^ 4 * σ + 2 * u * e ^ 6 + 2 * u * e ^ 5 * σ) = cA u e * cB u e * (ct e σ + u) := by simp only [cA, cB, ct]; ring
  have eB : (u ^ 3 + 4 * u ^ 2 * e + 2 * u * e ^ 2) = cB u e := by simp only [cB]; ring
  have eA0 : (2 * u ^ 2 * e + 3 * u * e ^ 2 + e ^ 3) = cA u e := by simp only [cA]; ring
  rw [eA] at h1; rw [eL] at h2; rw [eW, eB, eA0] at h3
  simp only [one_mul, zero_mul, add_zero, zero_add] at h1 h2
  exact mem_ZT hu he hσ q h1 (by linarith) h3

