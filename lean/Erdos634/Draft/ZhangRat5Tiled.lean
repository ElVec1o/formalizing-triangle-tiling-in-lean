import Erdos634.Draft.ZhangRat4Tiled

/-!
# Zhang Prop 11 / Theorem 7: the exact range of Zhang's own tilings of the hypothesis triangle

The sides of the hypothesis triangle of Prop 11, `((a+2b)am, (b+2a)bm, c^2 m)`, are tiled by Zhang's own
results exactly when `m = b i + c j` with `i, j >= 0` (not both 0): `i = 0` is Prop 6(1) (`c | m`, sides
`(a+2b) (m/c) a c ...`), `j = 0` is Prop 6(2) (`b | m`), and `i, j >= 1` is Theorem 7 (his proof is the
combination `bk + ck'`; the printed bound `m > bc - b - c` is only the sufficient Frobenius range).
`ZhangThm7.zhang_thm7` already contains this case split (`thm7_kz`, `thm7_kpz`, `thm7_main`) under the
Frobenius hypothesis; here it is restated for the semigroup `<b, c>` itself.  `AdmS` is therefore the exact
range covered by the PRINTED proofs.  `Adm` (ZhangRat4Tiled) implies `AdmS`.  UNAUDITED.
Credit Zhang (arXiv 2512.22696v4), Beeson, Beeson-Zhang, Laczkovich.
-/

set_option maxHeartbeats 3200000

namespace Erdos634.ZhangRat4

open Erdos634.Geometry Erdos634.CertCoord Erdos634.CertGeom Erdos634.RegionDissection
  Erdos634.SssCongruent Erdos634.ZhangPara Erdos634.ZhangL1 Erdos634.ZhangLat Erdos634.ZhangProp6
  Erdos634.ZhangProp6b Erdos634.ZhangSporadic Erdos634.ZhangRat2

/-- `m` lies in the numerical semigroup generated by `b = a + d` and `c`. -/
def AdmS (a d c m : ℕ) : Prop := ∃ i j : ℕ, m = (a + d) * i + c * j

theorem adm_to_admS (a d c m : ℕ) (hcab : c * c = a * a + (a + d) * (a + d) + a * (a + d))
    (hcop : Nat.Coprime a (a + d)) (ha : 0 < a) (hd : 0 < d) (h : Adm a d c m) : AdmS a d c m := by
  rcases h with ⟨t, rfl⟩ | hlt
  · exact ⟨t, 0, by ring⟩
  · have hc : 0 < c := by
      rcases Nat.eq_zero_or_pos c with h | h
      · subst h; nlinarith [Nat.mul_pos ha ha]
      · exact h
    obtain ⟨i, j, hij⟩ := ZhangPara.frob (a + d) c m (ZhangThm7.coprime_b_c a d c hcab hcop) (by omega) hc hlt
    exact ⟨i, j, by rw [hij]; ring⟩

/-- **Theorem 7 on the whole semigroup** (positive `m`). -/
theorem thm7_semi (a d c m : ℕ) (ha : 0 < a) (hd : 0 < d)
    (hcab : c * c = a * a + (a + d) * (a + d) + a * (a + d)) (hcop : Nat.Coprime a (a + d))
    (hm : 0 < m) (hS : AdmS a d c m) :
    Dis (Rmodel (Nat.cast_pos.mpr ha : (0:ℝ) < a)
        (Nat.cast_pos.mpr (by omega) : (0:ℝ) < ((a + d : ℕ) : ℝ)))
      (LT 0 0 ((a : ℝ) * (a + 2 * ((a : ℝ) + d)) * m) 0
        (((a : ℝ) * (a + 2 * ((a : ℝ) + d)) - ((a : ℝ) + d) * (2 * a + ((a : ℝ) + d))) * m)
        ((((a : ℝ) + d)) * (2 * a + ((a : ℝ) + d)) * m))
      (((a + d) + 2 * a) * (a + 2 * (a + d)) * (m * m)) := by
  obtain ⟨i, j, hij⟩ := hS
  have hmR : (m : ℝ) = ((a : ℝ) + d) * i + c * j := by
    have := congrArg (fun n : ℕ => (n : ℝ)) hij
    push_cast at this; linarith
  rcases Nat.eq_zero_or_pos i with hi | hi
  · subst hi
    rcases Nat.eq_zero_or_pos j with hj | hj
    · subst hj; omega
    · have := ZhangThm7.thm7_kz a d c j ha hd hcab hcop hj
      have hm' : m = c * j := by rw [hij]; ring
      subst hm'
      refine (this.congr ?_ ?_)
      · push_cast; rfl
      · ring
  · rcases Nat.eq_zero_or_pos j with hj | hj
    · subst hj
      have := ZhangThm7.thm7_kpz a d c i ha hd hcab hcop hi
      have hm' : m = (a + d) * i := by rw [hij]; ring
      subst hm'
      refine (this.congr ?_ ?_)
      · push_cast; rfl
      · ring
    · have := ZhangThm7.thm7_main a d c i j ha hd hcab hcop hi hj
      refine (this.congr ?_ ?_)
      · rw [hmR]
      · rw [hij]; ring

section tiled
variable (a d c m : ℕ) (ha : 0 < a) (hd : 0 < d)
  (hcab : c * c = a * a + (a + d) * (a + d) + a * (a + d)) (hcop : Nat.Coprime a (a + d)) (hm : 0 < m)

include ha hd hcab hcop hm

/-- **Prop 11 (1) hypothesis triangle tiled for `m` in the semigroup `<b,c>`.** -/
theorem prop11_1_tiled_S (hS : AdmS a d c m) (Ax Ay Bx By Dx Dy : ℝ)
    (hD : 0 < det3 Ax Ay Dx Dy Bx By)
    (hAD : (Ax - Dx) ^ 2 + (Ay - Dy) ^ 2
      = ((((a : ℝ) + 2 * ((a + d : ℕ) : ℝ)) * (m : ℝ)) * a) ^ 2)
    (hBD : (Bx - Dx) ^ 2 + (By - Dy) ^ 2
      = (((((a + d : ℕ) : ℝ) + 2 * a) * ((a + d : ℕ) : ℝ)) * (m : ℝ)) ^ 2)
    (hAB : (Ax - Bx) ^ 2 + (Ay - By) ^ 2
      = ((((a : ℝ) ^ 2 + a * ((a + d : ℕ) : ℝ) + ((a + d : ℕ) : ℝ) ^ 2)) * (m : ℝ)) ^ 2) :
    Dis (RM a (a + d) ha (by omega)) (TriSet Ax Ay Dx Dy Bx By)
      (((a + d) + 2 * a) * (a + 2 * (a + d)) * (m * m)) := by
  have ha' : (0 : ℝ) < a := Nat.cast_pos.mpr ha
  have hd' : (0 : ℝ) < d := Nat.cast_pos.mpr hd
  have h7 := thm7_semi a d c m ha hd hcab hcop hm hS
  let T1 := T7 a d m ha hd hm
  let U := mkTri Ax Ay Dx Dy Bx By hD.ne'
  have p0 : T1.pts 0 = mkPt (shx 0 0 0) (shy 0 0) := rfl
  have p1 : T1.pts 1 = mkPt (shx 0 ((a : ℝ) * (a + 2 * ((a : ℝ) + d)) * m) 0) (shy 0 0) := rfl
  have p2 : T1.pts 2 = mkPt
      (shx 0 (((a : ℝ) * (a + 2 * ((a : ℝ) + d)) - ((a : ℝ) + d) * (2 * a + ((a : ℝ) + d))) * m)
        ((((a : ℝ) + d)) * (2 * a + ((a : ℝ) + d)) * m))
      (shy 0 ((((a : ℝ) + d)) * (2 * a + ((a : ℝ) + d)) * m)) := rfl
  have u0 : U.pts 0 = mkPt Ax Ay := rfl
  have u1 : U.pts 1 = mkPt Dx Dy := rfl
  have u2 : U.pts 2 = mkPt Bx By := rfl
  have hcong : T1.Congruent U := by
    apply congruent_of_dist_three
    · apply dist_of_sq
      rw [p0, p1, u0, u1, dist_sq_mkPt, dist_sq_mkPt, dsq_lat, hAD]
      push_cast; ring
    · apply dist_of_sq
      rw [p1, p2, u1, u2, dist_sq_mkPt, dist_sq_mkPt, dsq_lat]
      have : (Dx - Bx) ^ 2 + (Dy - By) ^ 2 = (Bx - Dx) ^ 2 + (By - Dy) ^ 2 := by ring
      rw [this, hBD]
      push_cast; ring
    · apply dist_of_sq
      rw [p2, p0, u2, u0, dist_sq_mkPt, dist_sq_mkPt, dsq_lat]
      have : (Bx - Ax) ^ 2 + (By - Ay) ^ 2 = (Ax - Bx) ^ 2 + (Ay - By) ^ 2 := by ring
      rw [this, hAB]
      push_cast; ring
  have h7' : Dis (RM a (a + d) ha (by omega)) T1.carrier
      (((a + d) + 2 * a) * (a + 2 * (a + d)) * (m * m)) := by
    rw [T7_carrier]; exact h7
  have := Dis_scale_congr (t := 1) one_pos h7' (T7_pts_self a d m ha hd hm) hcong
  rw [TriSet_eq_carrier hD]
  refine this.congr rfl ?_
  ring

/-- **Prop 11 (2), same, vertex order `(B,D,A)`.** -/
theorem prop11_2_tiled_S (hS : AdmS a d c m) (Ax Ay Bx By Dx Dy : ℝ)
    (hD : 0 < det3 Ax Ay Dx Dy Bx By)
    (hAD : (Ax - Dx) ^ 2 + (Ay - Dy) ^ 2
      = (((((a + d : ℕ) : ℝ) + 2 * a) * (m : ℝ)) * ((a + d : ℕ) : ℝ)) ^ 2)
    (hBD : (Bx - Dx) ^ 2 + (By - Dy) ^ 2
      = ((((a : ℝ) + 2 * ((a + d : ℕ) : ℝ)) * a) * (m : ℝ)) ^ 2)
    (hAB : (Ax - Bx) ^ 2 + (Ay - By) ^ 2
      = ((((a : ℝ) ^ 2 + a * ((a + d : ℕ) : ℝ) + ((a + d : ℕ) : ℝ) ^ 2)) * (m : ℝ)) ^ 2) :
    Dis (RM a (a + d) ha (by omega)) (TriSet Ax Ay Dx Dy Bx By)
      (((a + d) + 2 * a) * (a + 2 * (a + d)) * (m * m)) := by
  have h7 := thm7_semi a d c m ha hd hcab hcop hm hS
  let T1 := T7 a d m ha hd hm
  let U := mkTri Ax Ay Dx Dy Bx By hD.ne'
  let σ : Equiv.Perm (Fin 3) := Equiv.swap 0 2
  have p0 : T1.pts 0 = mkPt (shx 0 0 0) (shy 0 0) := rfl
  have p1 : T1.pts 1 = mkPt (shx 0 ((a : ℝ) * (a + 2 * ((a : ℝ) + d)) * m) 0) (shy 0 0) := rfl
  have p2 : T1.pts 2 = mkPt
      (shx 0 (((a : ℝ) * (a + 2 * ((a : ℝ) + d)) - ((a : ℝ) + d) * (2 * a + ((a : ℝ) + d))) * m)
        ((((a : ℝ) + d)) * (2 * a + ((a : ℝ) + d)) * m))
      (shy 0 ((((a : ℝ) + d)) * (2 * a + ((a : ℝ) + d)) * m)) := rfl
  have u0 : (permTri U σ).pts 0 = mkPt Bx By := by simp [permTri, σ, U]
  have s1 : σ 1 = 1 := Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)
  have u1 : (permTri U σ).pts 1 = mkPt Dx Dy := by simp [permTri, s1, U]
  have u2 : (permTri U σ).pts 2 = mkPt Ax Ay := by simp [permTri, σ, U]
  have hcong : T1.Congruent U := by
    refine (congruent_of_dist_three (U := permTri U σ) ?_ ?_ ?_).trans (congruent_permTri U σ)
    · apply dist_of_sq
      rw [p0, p1, u0, u1, dist_sq_mkPt, dist_sq_mkPt, dsq_lat, hBD]
      push_cast; ring
    · apply dist_of_sq
      rw [p1, p2, u1, u2, dist_sq_mkPt, dist_sq_mkPt, dsq_lat]
      have : (Dx - Ax) ^ 2 + (Dy - Ay) ^ 2 = (Ax - Dx) ^ 2 + (Ay - Dy) ^ 2 := by ring
      rw [this, hAD]
      push_cast; ring
    · apply dist_of_sq
      rw [p2, p0, u2, u0, dist_sq_mkPt, dist_sq_mkPt, dsq_lat]
      rw [hAB]
      push_cast; ring
  have h7' : Dis (RM a (a + d) ha (by omega)) T1.carrier
      (((a + d) + 2 * a) * (a + 2 * (a + d)) * (m * m)) := by
    rw [T7_carrier]; exact h7
  have := Dis_scale_congr (t := 1) one_pos h7' (T7_pts_self a d m ha hd hm) hcong
  rw [TriSet_eq_carrier hD]
  refine this.congr rfl ?_
  ring

end tiled
end Erdos634.ZhangRat4

#print axioms Erdos634.ZhangRat4.thm7_semi
#print axioms Erdos634.ZhangRat4.prop11_1_tiled_S
#print axioms Erdos634.ZhangRat4.prop11_2_tiled_S
