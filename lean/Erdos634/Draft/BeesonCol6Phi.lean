import Mathlib

/-!
# Beeson (arXiv 1206.2229 v4) Lemmas 19, 20, 21, 23: the direction coordinates `(n, ε)` and the functions `Φ1`, `Φ2`

NOTE, UNAUDITED.  Credit: Michael Beeson (arXiv 1206.2229 v4, Lemma 18-23, Definition 6), Beeson-Rosu, Laczkovich, Beeson-Zhang.
Formalization debt, not progress on the /goal outcomes.

Arithmetic content only (no tiling object): a direction is a real `n δ + ε π` (mod `2π`), `δ = α + β`, `3α + 2β = π`.
* `lemma19_inj`: `δ/π` irrational => `(n, ε) ↦ n δ + ε π` is injective modulo `2π` on `ℤ × {0,1}` (printed injectivity).
  NOT done: "all differences of edge directions of a tiling lie in the group generated by δ and π" (a geometric statement about tilings).
* `phi1`, `phi2` (Definition 6) and the properties of Lemma 20: values `±1`, `Φ(θ+π) = -Φ(θ)`, `Φ(-θ) = Φ(θ)`, `Φ(θ+2π) = Φ(θ)`.
  NOT done: the uniqueness sentence ("the only two functions ...").
* Lemma 21: the exterior angles `π-γ = δ`, `π-α = 2δ`, `π-β = 2π-3δ` (`lemma21_turns`), so the directions of `a, b, c` are
  `(n, ε), (n+1, ε), (n+3, ε)` (`lemma21_dirs`); `lemma21_tile_values`: `Φ1(t) = (-1)^ε (a+b+c)`, `Φ2(t) = (-1)^(n+ε)(a-b-c)`,
  and for a reflected tile `(n, n-1, n-3)` the same values.
* Lemma 23: the table of signs of `Φ1, Φ2` on `AB, BC, CA` for the five shapes (`lemma23_table`).
-/

namespace Erdos634.BeesonCol6

/-- the direction with coordinates `(n, ε)`. -/
noncomputable def dirv (δ : ℝ) (n ε : ℤ) : ℝ := n * δ + ε * Real.pi

/-- sign `(-1)^m`. -/
def sg (m : ℤ) : ℤ := if Even m then 1 else -1

theorem sg_add_one (m : ℤ) : sg (m + 1) = - sg m := by
  unfold sg; by_cases h : Even m
  · have : ¬ Even (m + 1) := by simpa [Int.even_add_one] using h
    simp [h, this]
  · have : Even (m + 1) := by simpa [Int.even_add_one] using h
    simp [h, this]

theorem sg_neg (m : ℤ) : sg (-m) = sg m := by unfold sg; simp

theorem sg_add_two_mul (m j : ℤ) : sg (m + 2 * j) = sg m := by
  have : Even (m + 2 * j) ↔ Even m := by simp [Int.even_add]
  unfold sg; simp [this]

theorem sg_add_two (m : ℤ) : sg (m + 2) = sg m := by simpa using sg_add_two_mul m 1

theorem sg_cases (m : ℤ) : sg m = 1 ∨ sg m = -1 := by unfold sg; split_ifs <;> simp

/-- `Φ1 (n δ + ε π) = (-1)^ε`. -/
def phi1 (_n ε : ℤ) : ℤ := sg ε
/-- `Φ2 (n δ + ε π) = (-1)^(n+ε)`. -/
def phi2 (n ε : ℤ) : ℤ := sg (n + ε)

/-- **Lemma 19 (injectivity).**  If `δ/π` is irrational, `n δ + ε π ≡ n' δ + ε' π (mod 2π)` with `ε, ε' ∈ {0,1}` gives `n = n'`, `ε = ε'`. -/
theorem lemma19_inj {δ : ℝ} (hirr : ¬ ∃ q : ℚ, δ = (q : ℝ) * Real.pi) {n n' ε ε' : ℤ}
    (hε : ε = 0 ∨ ε = 1) (hε' : ε' = 0 ∨ ε' = 1) (k : ℤ)
    (h : dirv δ n ε = dirv δ n' ε' + 2 * Real.pi * k) : n = n' ∧ ε = ε' := by
  unfold dirv at h
  have hpi := Real.pi_pos
  have hnn : n = n' := by
    by_contra hne
    apply hirr
    have hd : (n : ℝ) - n' ≠ 0 := by
      intro h0; apply hne; exact_mod_cast (sub_eq_zero.mp h0)
    refine ⟨((ε' - ε + 2 * k : ℤ) : ℚ) / ((n - n' : ℤ) : ℚ), ?_⟩
    push_cast
    rw [div_mul_eq_mul_div, eq_div_iff hd]
    linarith
  subst hnn
  refine ⟨rfl, ?_⟩
  have h2 : ((ε : ℝ) - ε') = 2 * k := by
    have : ((ε : ℝ) - ε') * Real.pi = (2 * k) * Real.pi := by linarith
    exact mul_right_cancel₀ hpi.ne' this
  have h3 : ε - ε' = 2 * k := by exact_mod_cast h2
  rcases hε with rfl | rfl <;> rcases hε' with rfl | rfl <;> omega

/-! ### Lemma 20 -/
theorem phi_vals (n ε : ℤ) : (phi1 n ε = 1 ∨ phi1 n ε = -1) ∧ (phi2 n ε = 1 ∨ phi2 n ε = -1) :=
  ⟨sg_cases ε, sg_cases (n + ε)⟩

/-- `Φ(θ + π) = -Φ(θ)`: `ε ↦ ε + 1`. -/
theorem phi_add_pi (n ε : ℤ) : phi1 n (ε + 1) = - phi1 n ε ∧ phi2 n (ε + 1) = - phi2 n ε := by
  refine ⟨sg_add_one ε, ?_⟩
  unfold phi2; rw [← add_assoc]; exact sg_add_one (n + ε)

/-- `Φ(-θ) = Φ(θ)`: `(n, ε) ↦ (-n, ε)` (since `-ε π ≡ ε π`, `ε` mod 2). -/
theorem phi_neg (n ε : ℤ) : phi1 (-n) ε = phi1 n ε ∧ phi2 (-n) ε = phi2 n ε := by
  refine ⟨rfl, ?_⟩
  unfold phi2
  have : -n + ε = -(n + ε) + 2 * ε := by ring
  rw [this]
  have h2 := sg_add_two_mul
  rw [h2, sg_neg]

/-- `Φ(θ + 2π) = Φ(θ)` (the value does not depend on the representative mod `2π`): `ε ↦ ε + 2`. -/
theorem phi_add_two_pi (n ε : ℤ) : phi1 n (ε + 2) = phi1 n ε ∧ phi2 n (ε + 2) = phi2 n ε := by
  refine ⟨sg_add_two ε, ?_⟩
  unfold phi2; rw [← add_assoc]; exact sg_add_two (n + ε)

theorem sg_sub_one (m : ℤ) : sg (m - 1) = - sg m := by
  have := sg_add_one (m - 1); rw [sub_add_cancel] at this; linarith

/-! ### Lemma 21 -/

/-- exterior angles of a tile: `π - γ = δ`, `π - α = 2δ`, `π - β = 2π - 3δ`. -/
theorem lemma21_turns {α β γ δ : ℝ} (hrel : 3 * α + 2 * β = Real.pi) (hδ : δ = α + β) (hγ : γ = Real.pi - α - β) :
    Real.pi - γ = δ ∧ Real.pi - α = 2 * δ ∧ Real.pi - β = 2 * Real.pi - 3 * δ := by
  refine ⟨by linarith, by linarith, by linarith⟩

/-- the edge directions of a counterclockwise tile starting along `a` with coordinates `(n, ε)`: `b` has `(n+1, ε)`,
`c` has `(n+3, ε)`, and the last turn returns to `a` (plus `2π`). -/
theorem lemma21_dirs {α β γ δ : ℝ} (hrel : 3 * α + 2 * β = Real.pi) (hδ : δ = α + β) (hγ : γ = Real.pi - α - β) (n ε : ℤ) :
    dirv δ n ε + (Real.pi - γ) = dirv δ (n + 1) ε ∧ dirv δ (n + 1) ε + (Real.pi - α) = dirv δ (n + 3) ε ∧
      dirv δ (n + 3) ε + (Real.pi - β) = dirv δ n ε + 2 * Real.pi := by
  obtain ⟨h1, h2, h3⟩ := lemma21_turns hrel hδ hγ
  unfold dirv; push_cast
  refine ⟨by rw [h1]; ring, by rw [h2]; ring, by rw [h3]; ring⟩

/-- a reflected tile: indices `n, n-1, n-3`. -/
theorem lemma21_dirs_refl {α β γ δ : ℝ} (hrel : 3 * α + 2 * β = Real.pi) (hδ : δ = α + β) (hγ : γ = Real.pi - α - β) (n ε : ℤ) :
    dirv δ n ε - (Real.pi - γ) = dirv δ (n - 1) ε ∧ dirv δ (n - 1) ε - (Real.pi - α) = dirv δ (n - 3) ε ∧
      dirv δ (n - 3) ε - (Real.pi - β) = dirv δ n ε - 2 * Real.pi := by
  obtain ⟨h1, h2, h3⟩ := lemma21_turns hrel hδ hγ
  unfold dirv; push_cast
  refine ⟨by rw [h1]; ring, by rw [h2]; ring, by rw [h3]; ring⟩

/-- tile values (Lemma 21): `Φ1(t) = (-1)^ε (a+b+c)`, `Φ2(t) = (-1)^(n+ε) (a-b-c)`; same for the reflected placement. -/
theorem lemma21_tile_values (a b c : ℝ) (n ε : ℤ) :
    a * (phi1 n ε) + b * (phi1 (n + 1) ε) + c * (phi1 (n + 3) ε) = (sg ε : ℝ) * (a + b + c) ∧
    a * (phi2 n ε) + b * (phi2 (n + 1) ε) + c * (phi2 (n + 3) ε) = (sg (n + ε) : ℝ) * (a - b - c) ∧
    a * (phi1 n ε) + b * (phi1 (n - 1) ε) + c * (phi1 (n - 3) ε) = (sg ε : ℝ) * (a + b + c) ∧
    a * (phi2 n ε) + b * (phi2 (n - 1) ε) + c * (phi2 (n - 3) ε) = (sg (n + ε) : ℝ) * (a - b - c) := by
  have e1 : sg (n + 1 + ε) = - sg (n + ε) := by rw [show n + 1 + ε = (n + ε) + 1 by ring]; exact sg_add_one _
  have e3 : sg (n + 3 + ε) = - sg (n + ε) := by
    rw [show n + 3 + ε = (n + ε + 1) + 2 by ring, sg_add_two, sg_add_one]
  have f1 : sg (n - 1 + ε) = - sg (n + ε) := by rw [show n - 1 + ε = (n + ε) - 1 by ring]; exact sg_sub_one _
  have f3 : sg (n - 3 + ε) = - sg (n + ε) := by
    rw [show n - 3 + ε = (n + ε - 1) - 2 by ring]
    have := sg_add_two ((n + ε - 1) - 2); rw [sub_add_cancel] at this; rw [← this, sg_sub_one]
  unfold phi1 phi2
  refine ⟨by ring, ?_, by ring, ?_⟩
  · rw [e1, e3]; push_cast; ring
  · rw [f1, f3]; push_cast; ring

/-! ### Lemma 23: the sign table.  Angles at `A, B, C`; `θ_AB = 0`, `θ_BC = θ_AB + π - B`, `θ_CA = θ_BC + π - C`. -/

/-- Row `(2α, β, α+β)`: `BC = (-3, 0)`, `CA = (-4, 1)`; `Φ1 = +,-`; `Φ2 = -,-`. -/
theorem lemma23_row1 {α β δ : ℝ} (hα : α = Real.pi - 2 * δ) (hβ : β = 3 * δ - Real.pi) :
    (Real.pi - (β) = dirv δ (-3) 0 + 2 * Real.pi * (1)) ∧
    (Real.pi - (β) + (Real.pi - (α + β)) = dirv δ (-4) 1 + 2 * Real.pi * (1)) ∧
    (phi1 (-3) 0 = 1 ∧ phi1 (-4) 1 = -1 ∧ phi2 (-3) 0 = -1 ∧ phi2 (-4) 1 = -1) := by
  refine ⟨?_, ?_, by decide⟩ <;> (unfold dirv; push_cast; simp only [hα, hβ]; ring)

/-- Row `(β, 3α, β)`: `BC = (6, 0)`, `CA = (3, 0)`; `Φ1 = +,+`; `Φ2 = +,-`. -/
theorem lemma23_row2 {α β δ : ℝ} (hα : α = Real.pi - 2 * δ) (hβ : β = 3 * δ - Real.pi) :
    (Real.pi - (3 * α) = dirv δ (6) 0 + 2 * Real.pi * (-1)) ∧
    (Real.pi - (3 * α) + (Real.pi - (β)) = dirv δ (3) 0 + 2 * Real.pi * (0)) ∧
    (phi1 6 0 = 1 ∧ phi1 3 0 = 1 ∧ phi2 6 0 = 1 ∧ phi2 3 0 = -1) := by
  refine ⟨?_, ?_, by decide⟩ <;> (unfold dirv; push_cast; simp only [hα, hβ]; ring)

/-- Row `(α+β, α, α+β)`: `BC = (2, 0)`, `CA = (1, 1)`; `Φ1 = +,-`; `Φ2 = +,+`. -/
theorem lemma23_row3 {α β δ : ℝ} (hα : α = Real.pi - 2 * δ) (hβ : β = 3 * δ - Real.pi) :
    (Real.pi - (α) = dirv δ (2) 0 + 2 * Real.pi * (0)) ∧
    (Real.pi - (α) + (Real.pi - (α + β)) = dirv δ (1) 1 + 2 * Real.pi * (0)) ∧
    (phi1 2 0 = 1 ∧ phi1 1 1 = -1 ∧ phi2 2 0 = 1 ∧ phi2 1 1 = 1) := by
  refine ⟨?_, ?_, by decide⟩ <;> (unfold dirv; push_cast; simp only [hα, hβ]; ring)

/-- Row `(α, α+2β, α)`: `BC = (-4, 0)`, `CA = (-2, 0)`; all `+`. -/
theorem lemma23_row4 {α β δ : ℝ} (hα : α = Real.pi - 2 * δ) (hβ : β = 3 * δ - Real.pi) :
    (Real.pi - (α + 2 * β) = dirv δ (-4) 0 + 2 * Real.pi * (1)) ∧
    (Real.pi - (α + 2 * β) + (Real.pi - (α)) = dirv δ (-2) 0 + 2 * Real.pi * (1)) ∧
    (phi1 (-4) 0 = 1 ∧ phi1 (-2) 0 = 1 ∧ phi2 (-4) 0 = 1 ∧ phi2 (-2) 0 = 1) := by
  refine ⟨?_, ?_, by decide⟩ <;> (unfold dirv; push_cast; simp only [hα, hβ]; ring)

/-- Row `(2α, α, 2β)`: `BC = (2, 0)`, `CA = (-4, 1)`; `Φ1 = +,-`; `Φ2 = +,-`. -/
theorem lemma23_row5 {α β δ : ℝ} (hα : α = Real.pi - 2 * δ) (hβ : β = 3 * δ - Real.pi) :
    (Real.pi - (α) = dirv δ (2) 0 + 2 * Real.pi * (0)) ∧
    (Real.pi - (α) + (Real.pi - (2 * β)) = dirv δ (-4) 1 + 2 * Real.pi * (1)) ∧
    (phi1 2 0 = 1 ∧ phi1 (-4) 1 = -1 ∧ phi2 2 0 = 1 ∧ phi2 (-4) 1 = -1) := by
  refine ⟨?_, ?_, by decide⟩ <;> (unfold dirv; push_cast; simp only [hα, hβ]; ring)

theorem lemma23_AB : phi1 0 0 = 1 ∧ phi2 0 0 = 1 := by decide

/-- non-vacuity: `δ = 1` has `δ/π` irrational; `δ = 2π/5` gives `α = β = π/5` (hypotheses of Lemmas 21, 23). -/
theorem phi_wit : (¬ ∃ q : ℚ, (1 : ℝ) = (q : ℝ) * Real.pi) ∧
    (3 * (Real.pi / 5) + 2 * (Real.pi / 5) = Real.pi ∧ (2 * Real.pi / 5 : ℝ) = Real.pi / 5 + Real.pi / 5 ∧
      Real.pi / 5 = Real.pi - 2 * (2 * Real.pi / 5) ∧ Real.pi / 5 = 3 * (2 * Real.pi / 5) - Real.pi) := by
  refine ⟨?_, by ring, by ring, by ring, by ring⟩
  rintro ⟨q, hq⟩
  have hirr := irrational_pi
  by_cases h0 : q = 0
  · subst h0; simp at hq
  · apply hirr
    refine ⟨q⁻¹, ?_⟩
    have : Real.pi = (q : ℝ)⁻¹ := by
      have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast h0
      field_simp; linarith
    simpa using this.symm

end Erdos634.BeesonCol6

