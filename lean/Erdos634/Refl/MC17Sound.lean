import Erdos634.Refl.MC17Data0
import Erdos634.Refl.SoundN
import Erdos634.NormalPosition

/-! GENERATED by (private working notes, not included)  Free-branch-point (`CheckM`) refutation of instance `C17`:
    target `(0, 0), (24, 0), ((127/6), (17/6)·√35)`, tile sides `(3 8 9)`; 33 nodes in 1 pieces.
    `not_dissection`: no `CongruentDissection` (any `N`) has target congruent to `TGT` and model congruent to `MODEL`. -/

open Erdos634.CertNode Erdos634.Geometry Erdos634.CertCoord

namespace Refl.MC17
open Refl

theorem hDn : (0:ℝ) < 35 := by norm_num
theorem TGT_pos : 0 < ef 0 0 24 0 (127/6) (17/6) := by unfold ef; norm_num
noncomputable def TGT : Erdos634.Geometry.Tri := rtri 35 hDn 0 0 24 0 (127/6) (17/6) TGT_pos
theorem MODEL_pos : 0 < ef 0 0 3 0 (13/3) (4/3) := by unfold ef; norm_num
noncomputable def MODEL : Erdos634.Geometry.Tri := rtri 35 hDn 0 0 3 0 (13/3) (4/3) MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 3 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 8 ∧
    dist (MODEL.pts 0) (MODEL.pts 2) = 9 :=
  model_sides_rp hDn MODEL_pos (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
theorem tgt_ok : inst.tgt.ok = true := by decide +kernel
theorem tgt_carr : inst.tgt.carr 35 = TGT.carrier := by
  obtain ⟨hp, h⟩ := Tri.ok_sem 35 hDn inst.tgt tgt_ok
  rw [h]
  have e1 : inst.tgt.a.X = 0 := by simp [inst, pt, Pt.X]
  have e2 : inst.tgt.a.Y = 0 := by simp [inst, pt, Pt.Y]
  have e3 : inst.tgt.b.X = 24 := by simp [inst, pt, Pt.X]
  have e4 : inst.tgt.b.Y = 0 := by simp [inst, pt, Pt.Y]
  have e5 : inst.tgt.c.X = (127/6) := by simp [inst, pt, Pt.X]
  have e6 : inst.tgt.c.Y = (17/6) := by simp [inst, pt, Pt.Y]
  unfold TGT
  simp only [e1, e2, e3, e4, e5, e6]
theorem hMa : dist (MODEL.pts 0) (MODEL.pts 1) = (inst.sides.1 : ℝ) := by simpa [inst] using MODEL_sides.1
theorem hMb : dist (MODEL.pts 1) (MODEL.pts 2) = (inst.sides.2.1 : ℝ) := by simpa [inst] using MODEL_sides.2.1
theorem hMc : dist (MODEL.pts 0) (MODEL.pts 2) = (inst.sides.2.2 : ℝ) := by simpa [inst] using MODEL_sides.2.2
theorem hDnI : ((inst.Dn : ℤ) : ℝ) = 35 := by norm_num [inst]

theorem sound0 : Sound 35 inst MODEL cfg0 :=
  checkNodeN_sound 35 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn0 (by intro c hc; simp [kn0] at hc) (by intro c hc; simp [kn0] at hc) 4000 cfg0 tree0
    (fun t ht => List.all_eq_true.mp cfgok0 t ht) ok0

theorem not_dissection {N : ℕ} (D : CongruentDissection N)
    (hT : D.target.Congruent TGT) (hM : D.model.Congruent MODEL) : False := by
  obtain ⟨g, D', hD'T, hD'M, -⟩ := Erdos634.NormalPosition.exists_normal_position_congruent D hT
  exact sound0 (N := N) D' (by rw [hD'T, tgt_carr]) (by rw [hD'M]; exact hM) (by simp [cfg0])

end Refl.MC17
#print axioms Refl.MC17.not_dissection
